# Compiled binaries (root-level only, not source directories)
/batesian
/batesian.exe
/dist/
/build/
/bin/
*.dll
*.so
*.dylib

# Go test/build artifacts
*.test
*.out
/vendor/

# go.sum is intentionally tracked (ensures reproducible builds)

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
*.egg
.pytest_cache/

# Environment / secrets
.env
.env.*
*.pem
*.key
secrets.yaml
secrets.json
# Per-developer agent settings. This file holds an auth token in cleartext, and
# nothing under .claude/ is tracked, so it was one `git add .` away from being
# published. Only the local file is ignored: a shared .claude/settings.json remains
# committable if the project ever wants one.
.claude/settings.local.json

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Cursor IDE
.cursor/

# Internal planning (keep local only)
ROADMAP.md

# Test artifacts
/test/output/
*.sarif.tmp
coverage.out
coverage.html

# Go profiling and benchmark output
*.prof
cpu.out
mem.out
trace.out

# Test server logs generated at runtime
*.log
*_err.log

# Scan output artifacts generated during dev/validation
testdata/*.sarif
testdata/*.json
*.sarif
